# Finviz Elite — auto-login using your account credentials
FINVIZ_EMAIL=your_finviz_email@example.com
FINVIZ_PASSWORD=your_finviz_password

# Optional: hard-code an already-obtained session cookie to skip the login step.
# If set, this takes priority over email/password.
# FINVIZ_SESSION_COOKIE=

# Tradier API — options greeks + live equity quotes (production or sandbox)
TRADIER_TOKEN=your_tradier_api_token
TRADIER_ENV=production

# TradingView Alert Webhooks — shared secret that must appear in the JSON
# body of every alert payload posted to /api/tradingview/webhook (TradingView
# can't send custom headers, so the secret travels inside the message JSON).
# See lib/tradingview.ts for the alert setup steps.
TRADINGVIEW_WEBHOOK_SECRET=your_random_webhook_secret

# ─── Tradevi Premium — PayPal Subscriptions ($7.99/mo) ────────────────────
# See SUBSCRIPTIONS.md for the full setup walkthrough and real fee numbers.
# Use sandbox values first, flip PAYPAL_ENV to "live" once verified.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_rest_client_id
PAYPAL_CLIENT_SECRET=your_paypal_rest_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Public — safe to expose in the browser bundle. The Client ID is meant to be
# public (it's how PayPal's own checkout buttons work); the Secret above is not.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_rest_client_id
NEXT_PUBLIC_PAYPAL_PLAN_ID=your_paypal_billing_plan_id

# ─── User accounts — Supabase (free tier) ──────────────────────────────────
# Create a free project at https://supabase.com, then Project Settings → API.
# See SUBSCRIPTIONS.md for the full setup walkthrough, including the SQL to
# run for the subscriptions table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public site origin used in signup / reset emails. Must be a URL a phone can
# open — never localhost. Defaults to https://tradevi.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=https://tradevi.vercel.app

# Server-only — never expose this one to the browser. Used solely by the
# PayPal webhook to update subscription status on behalf of users who don't
# have an active browser session at the time PayPal calls the webhook.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Comma-separated email(s) that get free access with no PayPal subscription
# required — use this for your own account(s). Must exactly match the email
# the account signed up with. Leave unset and nobody gets free access.
OWNER_EMAILS=you@example.com
