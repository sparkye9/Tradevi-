# Finviz Elite — auto-login using your account credentials
FINVIZ_EMAIL=your_finviz_email@example.com
FINVIZ_PASSWORD=your_finviz_password

# Optional: hard-code an already-obtained session cookie to skip the login step.
# If set, this takes priority over email/password.
# FINVIZ_SESSION_COOKIE=

# Tradier API — options greeks + live equity quotes (production or sandbox)
TRADIER_TOKEN=your_tradier_api_token
TRADIER_ENV=production

# TradingView Alert Webhooks — shared secret that must appear in the JSON
# body of every alert payload posted to /api/tradingview/webhook (TradingView
# can't send custom headers, so the secret travels inside the message JSON).
# See lib/tradingview.ts for the alert setup steps.
TRADINGVIEW_WEBHOOK_SECRET=your_random_webhook_secret

# ─── Supabase (optional) ────────────────────────────────────────────────────
# Only used to store TradingView webhook alerts. Accounts and subscriptions
# have been removed — the site is open to everyone.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only — never expose this one to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
