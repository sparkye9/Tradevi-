# Finviz Elite — auto-login using your account credentials
FINVIZ_EMAIL=your_finviz_email@example.com
FINVIZ_PASSWORD=your_finviz_password

# Optional: hard-code an already-obtained session cookie to skip the login step.
# If set, this takes priority over email/password.
# FINVIZ_SESSION_COOKIE=

# Tradier API — options greeks (production or sandbox)
TRADIER_TOKEN=your_tradier_api_token
TRADIER_ENV=production

# Protects /api/cron/daily-scan from being triggered by anyone but Vercel Cron.
# Vercel sets this automatically as an env var and sends it back as
# `Authorization: Bearer $CRON_SECRET` on every cron invocation — just add
# it once in Project Settings > Environment Variables.
CRON_SECRET=

# How many screener pages (20 tickers/page) to pull per exchange in the STEP 1
# full-market scan. 15 (default) = up to ~900 liquid names across
# NYSE+NASDAQ+AMEX. Raise it for deeper coverage; each extra page is one more
# Finviz request, so keep an eye on rate limits / scan duration.
# FINVIZ_UNIVERSE_PAGES_PER_EXCHANGE=15

# ─── PERSISTENCE FOR THE DAILY SCAN ──────────────────────────────────────────
# Without this, the 4 AM cron scan and later page loads can land on different
# serverless instances and never see each other's cache — every page load
# re-scans the market from scratch. To fix it: in the Vercel dashboard, go to
# your project > Storage > Create Database > KV (Upstash-backed, free tier
# available), then connect it to this project. Vercel injects these two
# automatically — you shouldn't need to set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
