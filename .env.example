# Finviz Elite — auto-login using your account credentials
FINVIZ_EMAIL=your_finviz_email@example.com
FINVIZ_PASSWORD=your_finviz_password

# Optional: hard-code an already-obtained session cookie to skip the login step.
# If set, this takes priority over email/password.
# FINVIZ_SESSION_COOKIE=

# Tradier API — options greeks (production or sandbox)
TRADIER_TOKEN=your_tradier_api_token
TRADIER_ENV=production

# ─── Tradevi Premium — PayPal Subscriptions ($7.99/mo) ────────────────────
# See SUBSCRIPTIONS.md for the full setup walkthrough and real fee numbers.
# Use sandbox values first, flip PAYPAL_ENV to "live" once verified.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_rest_client_id
PAYPAL_CLIENT_SECRET=your_paypal_rest_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Public — safe to expose in the browser bundle. The Client ID is meant to be
# public (it's how PayPal's own checkout buttons work); the Secret above is not.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_rest_client_id
NEXT_PUBLIC_PAYPAL_PLAN_ID=your_paypal_billing_plan_id
