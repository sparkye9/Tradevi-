# Tradevi Premium — Vercel import file (PayPal + Supabase only)
#
# How to use:
# 1. Fill in every REPLACE_ME value below (do not import placeholders).
# 2. Vercel → Project → Settings → Environment Variables → Import.
# 3. Apply to Production (and Preview if you want).
# 4. Redeploy.
#
# PayPal dashboard URLs are NOT env vars. Put these in PayPal, not Vercel:
#   Webhook URL:        https://tradevi.vercel.app/api/paypal/webhook
#   Auto-return URL:    https://tradevi.vercel.app/subscribe
#   Cancel-return URL:  https://tradevi.vercel.app/subscribe

# ── PayPal (developer.paypal.com → Apps & Credentials) ────────────────────
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME
PAYPAL_WEBHOOK_ID=REPLACE_ME
NEXT_PUBLIC_PAYPAL_CLIENT_ID=REPLACE_ME
NEXT_PUBLIC_PAYPAL_PLAN_ID=REPLACE_ME

# ── Supabase (supabase.com → Project Settings → API) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ── Your free access (must match the email you sign up with) ──────────────
OWNER_EMAILS=REPLACE_ME@example.com
